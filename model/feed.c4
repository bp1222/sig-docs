// Signal feed: include/sig/feed/sig_signal_feed.h (src/feed/sig_signal_feed.c, sig_feed_hub.c + sig_feed_hub.h,
// sig_feed_msg.c + sig_feed_msg.h, sig_signal_feed_priv.h [test hooks]). Build option SIG_SIGNAL_FEED (CMakeLists.txt:31-33,
// 154-167): OFF by default, requires SIG_HTTP_SERVER (and so SIG_NET); sig::signal_feed links sig_http_server.
//
// Sources (everything below was checked against these):
//   include/sig/feed/sig_signal_feed.h               wire protocol, limits, threading paragraph, "SECURITY: the feed is UNAUTHENTICATED", registration order
//   src/feed/sig_feed_hub.h                          threading contract of the hub; limits SIG_FEED_QUEUE_MAX_ENTRIES 256, _MAX_BYTES 256 KiB, SIG_FEED_VALUE_MAX_BYTES 64 KiB
//   src/feed/sig_feed_hub.c:14-45                    struct sig_feed_sub (mutex-guarded ll queue, counters, tail_dropped, orphan_drops) and struct sig_feed_hub (ctl mutex, rwlock, subs array, installed flag)
//   src/feed/sig_feed_hub.c:67-104                   estimate(): 32 bytes per node plus string and bytes lengths and key lengths; false past 64 KiB or the nesting limit
//   src/feed/sig_feed_hub.c:124-187                  record_drop merges consecutive drops into the tail DROPPED entry (or counts them in orphan_drops if it cannot allocate); offer drops when
//                                                    the value does not fit, 256 signals are queued, or 256 KiB would be exceeded; otherwise sig_value_dup and push, seq++ only on success
//   src/feed/sig_feed_hub.c:189-222                  sig_feed_sub_pop: orphan drops first, then the queue head
//   src/feed/sig_feed_hub.c:258-286                  hub_tap: shared hub lock; compares dir, terminal, instance and service name; estimates the size once; offer() under the subscription mutex
//   src/feed/sig_feed_hub.c:316-352                  uninstall_tap: sig_runtime_set_tap(NULL), then waits out running callbacks by taking and releasing the write lock
//   src/feed/sig_feed_hub.c:394-443                  subscribe: names of 64 or more characters are SIG_ERR_NOT_FOUND; sig_runtime_find_terminal under ctl; add; set_tap on EVERY successful
//                                                    subscribe (not only the first: the comment says the runtime forgets the tap when it stops); on failure the subscription is removed again
//   src/feed/sig_feed_hub.c:445-457                  unsubscribe: removes the subscription; uninstalls the tap when none is left
//   src/feed/sig_signal_feed.c:21-40                 constants: path "/feed", 8 connections, 16 subscriptions, 4096-byte payload, 1 MiB write cap, 20 ms flush, 30 s stall, 5 s close, 30 s ping, 75 s idle
//   src/feed/sig_signal_feed.c:122-189               write buffer and queue_frame / queue_close
//   src/feed/sig_signal_feed.c:257-297               update_interest and conn_write (a completed close frame destroys the connection after draining input)
//   src/feed/sig_signal_feed.c:301-369               subscribe and unsubscribe commands: duplicate id is bad_request, 17th is too_many, hub NOT_FOUND is not_found, any other hub error is bad_request
//   src/feed/sig_signal_feed.c:375-450               process_frames: protocol error 1002, too large 1009, text, ping answered with pong, close echoed (1000 when empty), backpressure at the write cap
//   src/feed/sig_signal_feed.c:458-543               check_deadlines and flush_connection / flush_tick: every 20 ms, while any connection exists, each subscription is popped (while under the write cap) and encoded
//   src/feed/sig_signal_feed.c:549-700               conn_adopt, drain_pending (private loop step hook), refuse (101 then close 1013), on_upgrade (SIG_ERR_STATE if not running -> 503 from the server)
//   src/feed/sig_signal_feed.c:704-843               feed_create (no config; needs http_server; hub create; register_upgrade("/feed")), feed_start (runtime loop, else a private loop and one thread),
//                                                    feed_stop (running=false, stop and join the private thread, free pending and all connections), feed_destroy (hub destroy)
//   src/feed/sig_feed_msg.c:30-79                    parse_command: bad JSON is SIG_ERR_PARSE, everything else SIG_ERR_INVALID_ARG; names 1..63 bytes; id echoed when readable
//   src/feed/sig_feed_msg.c:81-199                   encoders: signal (seq, t, type, value as JSON), dropped (count), subscribed (dir in/out), error (id optional)
//   src/runtime/sig_runtime.c:231-281                sig_runtime_set_tap (ctl_mtx, SIG_ERR_STATE unless RUNNING, walks the services) and sig_runtime_find_terminal
//   src/runtime/sig_capsule.c:449-477                notify taps SIG_TAP_OUTPUT before the route lookup (so unrouted outputs are seen)
//   src/http/sig_http_server.c:328-346,440-451,701-729  upgrade validation, then the hand-off: offer_upgrade (threaded) and conn_read (loop)
//   docs/signal-feed.md                              used as the lead; every number above was re-read in the code. Differences are listed in the task report
model {
  extend sig {
    feed = module 'Signal feed' {
      technology 'sig_signal_feed.h; sig::signal_feed, SIG_SIGNAL_FEED'
      description '
        Streams the signals crossing chosen capsule terminals to WebSocket
        clients as JSON text frames, on the path "/feed" of the shared HTTP server.
        A client names a service, instance and terminal and sees the signals from
        then on, with no history. The feed is unauthenticated: the only check is
        the Origin test the HTTP server makes. The runtime tap is the source of
        the data, and it is installed only while at least one subscription exists.
      '

      module = component 'Feed module' {
        technology 'sig_signal_feed_module; runtime module "signal_feed"'
        description '
          Takes no config. Its create hook needs the http_server module to be
          registered earlier, creates the hub and registers "/feed" as an upgrade
          prefix, which also makes the server listen. Its start hook uses the loop
          of the runtime if there is one, so everything runs on the loop thread;
          otherwise it creates a private loop and runs it on one thread of its own.
          Stop clears the running flag, stops and joins that thread, and closes every
          connection, which drops their subscriptions. Destroy frees the hub.
        '
      }

      upgrade = component 'Upgrade handler' {
        technology 'on_upgrade, refuse in sig_signal_feed.c'
        description '
          Called by the HTTP server for a validated WebSocket upgrade on "/feed". It
          computes the accept key and counts the connection. If 8 connections exist
          it writes the 101 response and a close frame with code 1013 and closes the
          socket. If the module is not running it declines, and the server answers
          503. Otherwise it takes ownership of the connection: directly, when the
          feed runs on the runtime loop, or through a hand-off list that the private
          loop drains in its step hook after being woken.
        '
      }

      connection = component 'WebSocket connection' {
        technology 'conn_on_fd, flush_tick in sig_signal_feed.c; sig_loop watch and timer'
        description '
          One connection with up to 16 subscriptions, each with a client-chosen id.
          It decodes masked client frames (payload up to 4096 bytes): a text frame
          is a subscribe or unsubscribe command, a ping gets a pong, a close is
          echoed. A protocol error closes with 1002 and an oversize frame with 1009.
          A bad command gets an error reply (bad_request, not_found, too_many) and
          the connection stays open. A 20 ms timer, running while any connection
          exists, pops the events of every subscription and writes them. More than
          1 MiB of unsent data stops both reading from the client and popping the
          queues, so the queues fill and the hub drops. It also drops a connection
          with no write progress for 30 s, a close not flushed within 5 s, or no
          inbound traffic for 75 s, and sends a ping every 30 s.
        '
      }

      hub = component 'Subscription hub' {
        technology 'sig_feed_hub_*; sig_feed_hub.c'
        description '
          The set of subscriptions, with no sockets. Subscribe checks that the
          service, instance and terminal exist in the running project, creates a
          subscription with the direction of the terminal, and asks the runtime to
          install the tap. Unsubscribe removes it, and when none is left asks the
          runtime to remove the tap; destroy does the same. Subscribe, unsubscribe
          and destroy are serialized by the hub and must not be called from a
          service thread, because they call the runtime. Subscriptions are matched
          by name, so they survive the rebuild of a service. They do not survive a
          stop of the runtime, which forgets the tap; the hub notices on its next
          subscribe or unsubscribe.
        '
      }

      tap = component 'Tap callback' {
        technology 'hub_tap in sig_feed_hub.c; sig_tap_fn'
        description '
          The function the runtime installs. It runs on the emitting thread, a
          service worker or the loop thread, for every signal in the system while
          the tap is installed. It takes the hub lock shared and, for each matching
          subscription (same direction, terminal, instance and service name), estimates
          the size of the value once and offers a copy to that subscription. It does
          no I/O and never calls the runtime. It can wait only on short locks: the
          hub lock, held exclusively briefly when a subscription is added or
          removed, and the mutex of one subscription. It allocates for the copy.
        '
      }

      queue = component 'Subscription queue' {
        technology 'offer, record_drop, sig_feed_sub_pop; sig_ll under a mutex'
        description '
          A bounded queue per subscription. A signal is queued as a deep copy with a
          sequence number and a Unix millisecond timestamp. It is dropped and
          counted when its estimated size is over 64 KiB, when 256 signals are
          already queued, or when 256 KiB of estimated data would be exceeded, and
          also when allocation fails. Consecutive drops merge into one marker
          at the tail, so the reader sees a dropped event with a count at the
          place in the stream where the values were lost. Dropped signals do not
          use a sequence number. Pop is non-blocking.
        '
      }

      messages = component 'Message encoding' {
        technology 'sig_feed_msg.c; sig_json, sig_value_json'
        description '
          Parses a client frame (bad JSON is a parse error; a non-object, an unknown
          op, or a missing, empty or 64-character-or-longer name is an invalid
          argument, with the id echoed when it could be read). Encodes the four
          server messages: subscribed (direction in or out), signal (id, seq, time,
          type name and the value as JSON), dropped (count) and error (the code, and
          the id when there is one).
        '
      }
    }
  }

  sig.feed.module -[calls]-> sig.runtime.modules 'registered as the runtime module "signal_feed"; create, start, stop and destroy hooks'
  sig.feed.module -[calls]-> sig.http.server 'sig_http_server_from_runtime and sig_http_server_register_upgrade("/feed") in create'
  sig.feed.module -[calls]-> sig.feed.hub 'creates it in create, destroys it in destroy'
  sig.feed.module -[calls]-> sig.runtime.loop 'uses the loop of the runtime, or creates a private one, runs it on one thread and stops it at stop'
  sig.feed.module -[calls]-> sig.platform.threads 'sig_thread_create and sig_thread_join for the private loop thread; a mutex for the running flag and counts'
  sig.http.looped -[calls]-> sig.feed.upgrade 'offers a validated upgrade connection on the loop thread, with the fd already unwatched'
  sig.http.threaded -[calls]-> sig.feed.upgrade 'offers a validated upgrade connection on the server thread'
  sig.feed.upgrade -[calls]-> sig.http.ws 'sig_ws_accept_key for the 101 response; sig_ws_encode for the 1013 close'
  sig.feed.upgrade -[calls]-> sig.feed.connection 'adopts the connection: directly on the loop thread, or via the hand-off list'
  sig.feed.upgrade -[calls]-> sig.platform.net 'one non-blocking write for the refusal, then closes the socket'
  sig.feed.connection -[calls]-> sig.http.ws 'sig_ws_decode of client frames; sig_ws_encode of every server frame'
  sig.feed.connection -[calls]-> sig.feed.messages 'parses commands; encodes events, replies and errors'
  sig.feed.connection -[calls]-> sig.feed.hub 'subscribe and unsubscribe, on the loop thread'
  sig.feed.connection -[calls]-> sig.feed.queue 'sig_feed_sub_pop for each subscription on every flush tick'
  sig.feed.connection -[calls]-> sig.runtime.loop 'sig_loop_watch_fd, watch_modify and the flush timer'
  sig.feed.connection -[calls]-> sig.platform.net 'non-blocking read and write on the socket'
  sig.feed.connection -[calls]-> sig.platform.time 'millisecond clock for the liveness deadlines'
  sig.feed.hub -[calls]-> sig.runtime.control 'sig_runtime_find_terminal validates the names and gives the direction'
  sig.feed.hub -[calls]-> sig.runtime.tap 'sig_runtime_set_tap installs the callback (on every successful subscribe) and removes it when the last subscription goes'
  sig.feed.hub -[calls]-> sig.feed.queue 'creates a queue with each subscription'
  sig.feed.hub -[calls]-> sig.platform.threads 'a mutex serializing hub calls and a reader-writer lock over the subscription table'
  sig.service.tap -[calls]-> sig.feed.tap 'calls the installed function on the emitting thread (the feed is the only user of sig_runtime_set_tap in this repository)'
  sig.feed.tap -[calls]-> sig.feed.queue 'offers a copy to each matching subscription'
  sig.feed.queue -[calls]-> sig.foundation.values 'sig_value_dup copies the signal'
  sig.feed.queue -[calls]-> sig.foundation.containers 'entries kept in a sig_ll'
  sig.feed.queue -[calls]-> sig.foundation.allocation 'entries'
  sig.feed.messages -[calls]-> sig.foundation.json 'sig_json writer; sig_value_from_json and sig_value_to_json'
  sig.feed.module -[calls]-> sig.foundation.logging 'logs why a connection was dropped, and configuration errors'
}

views {
  view feed {
    title 'Signal feed'
    include sig.feed, sig.feed.*
  }

  view feed_components of sig.feed {
    title 'Signal feed components'
    include *
  }

  dynamic view feed_subscription {
    title 'Subscribe to a terminal and receive its signals'
    description 'A client opens a WebSocket on /feed, subscribes to one terminal, and receives the signals that cross it. Shown for a runtime with an event loop, where the server, the feed and the services run on one thread; without a loop the server has a thread, the feed has a private loop thread and the services have workers, and the tap callback runs on the thread of whichever service emits. Checked against sig_signal_feed.c, sig_feed_hub.c, sig_runtime.c and sig_http_server.c, with docs/signal-feed.md as the lead.'

    sig.http.dispatch -> sig.http.dispatch 'GET /feed with Upgrade: websocket: the request is read in full, request_authorized() accepts it, Sec-WebSocket-Version must be 13, the key non-empty, and an Origin header, if present, must equal cors_origin (else 400 or 403). The longest upgrade prefix "/feed" matches'
    sig.http.looped -> sig.feed.upgrade 'the server unwatches the fd and offers the non-blocking connection to on_upgrade (the threaded transport does the same from its server thread)'
    sig.feed.upgrade -> sig.http.ws 'sig_ws_accept_key for the Sec-WebSocket-Accept value'
    sig.feed.upgrade -> sig.feed.connection 'fewer than 8 connections: the connection is adopted, watched on the loop, the 101 response queued and written, the 20 ms flush timer armed. (The ninth gets 101 plus a close frame 1013.)'
    sig.feed.connection -> sig.http.ws 'client frame {"op":"subscribe","id":"a","service":"S","instance":"I","terminal":"T"} is decoded and unmasked (at most 4096 bytes)'
    sig.feed.connection -> sig.feed.messages 'sig_feed_parse_command: names must be 1 to 63 bytes'
    sig.feed.connection -> sig.feed.hub 'sig_feed_hub_subscribe (an id already in use is bad_request, a 17th subscription is too_many; both are answered without calling the hub)'
    sig.feed.hub -> sig.runtime.control 'sig_runtime_find_terminal under the control mutex: not_found if the names do not exist, bad_request if the runtime is not running; gives the direction'
    sig.feed.hub -> sig.runtime.tap 'sig_runtime_set_tap(hub_tap): the subscription is already in the hub table, and the tap is installed on this subscribe (a later subscribe installs it again)'
    sig.runtime.tap -> sig.service.tap 'the tap is stored on every service of the running project; a service rebuilt later gets it too'
    sig.feed.connection -> sig.feed.messages 'reply {"op":"subscribed","id":"a","dir":"in|out"} is encoded and queued for the socket'
    sig.service.tap -> sig.feed.tap 'a signal crosses the terminal: sig_service_tap_emit calls hub_tap on the emitting thread, before an input handler or when an output is notified'
    sig.feed.tap -> sig.feed.queue 'for each subscription matching direction, terminal, instance and service name: a copy is queued with the next seq and a timestamp, or, when the queue is full or the value too large, a drop is counted (merged with a drop already at the tail). No I/O'
    sig.feed.connection -> sig.feed.queue 'flush tick, within 20 ms: sig_feed_sub_pop returns signals in order, with a dropped event with its count at the place where values were lost'
    sig.feed.connection -> sig.feed.messages 'each event is encoded as a signal or dropped message'
    sig.feed.connection -> sig.platform.net 'frames are written to the socket; if more than 1 MiB is unsent, popping and reading stop until the client catches up, and the queues drop'
    sig.feed.connection -> sig.feed.hub 'unsubscribe, or the connection closing: the subscription is freed. When the last subscription goes, the hub asks the runtime to remove the tap'
  }
}
