// Foundation: include/sig/base and include/sig/value (src/base, src/value).
//
// Sources (everything below was checked against these):
//   docs/architecture.md                 layering ("sig_value sig_json sig_ht sig_ll sig_log ..." inside sig::sig), build targets
//   CMakeLists.txt                       add_library(sig ...) lists src/base/*.c and src/value/*.c (always built);
//                                        sig_value_python.c is added only with SIG_PYTHON_BINDINGS (default OFF)
//   include/sig/base/sig_alloc.h         allocator hooks, counters "maintained (atomically) in every build", SIG_DEBUG site tracking
//   src/base/sig_alloc.c                 SIG_DEBUG block list guarded by an atomic_flag spinlock
//   include/sig/base/sig_atomic.h        sig_refcount_h over atomic_uint_least16_t
//   include/sig/base/sig_status.h        sig_status_t codes
//   include/sig/base/sig_ht.h            "sig_ht is NOT internally synchronized"
//   include/sig/base/sig_ll.h            "sig_ll is NOT internally synchronized"
//   include/sig/base/sig_log.h           init/shutdown precondition (before logging threads, after they are joined)
//   src/base/sig_log.c                   static sig_mutex log_mtx taken around each write (includes sig/platform/sig_thread.h)
//   include/sig/value/sig_value.h        containers backed by sig_ht/sig_ll; shared containers are frozen; one mutating thread at a time
//   src/value/sig_value.c                uses sig_ht_*/sig_ll_*, sig_refcount via sig_atomic.h, sig_log_debug
//   include/sig/value/sig_json.h         streaming writer, sticky allocation failure
//   include/sig/value/sig_value_json.h   sig_value <-> JSON; SIG_VALUE_MAX_DEPTH; bytes one-way base64
//   include/sig/value/sig_expr.h         "A compiled sig_expr is immutable; ... safe from several threads at once"
//   src/value/sig_expr.c, sig_value_json.c, sig_json.c   include sig/base/sig_alloc.h
//   include/sig/value/sig_value_python.h Python.h conversion
// Relationships are only those backed by an #include or call in the files above.
model {
  extend sig {
    foundation = module 'Foundation' {
      technology 'CMake target sig::sig (always built)'
      description '
        Allocation, status codes, reference counting, hash table and list,
        logging, the sig_value data model, JSON, and the expression language.
        Part of the sig::sig target and always built; it has no dependency on
        the optional modules. Its one dependency outside the module is
        logging, which takes a platform mutex (sig_thread.h).
      '

      allocation = component 'Allocation' {
        technology 'sig_alloc.h'
        description '
          sig_alloc, sig_calloc, sig_realloc, sig_free and sig_strdup, with an
          overridable allocator (sig_alloc_set_allocator). With SIG_DEBUG every
          block is tracked by file and line and the block list is guarded by a
          spinlock. The allocation counters are updated atomically in every
          build. Call sig_alloc_init once before any other sig_alloc_* function.
        '
      }

      status = component 'Status codes' {
        technology 'sig_status.h'
        description '
          sig_status_t: SIG_OK and the SIG_ERR_* codes (ALLOC, INVALID_ARG,
          NOT_FOUND, EXISTS, PLATFORM, TYPE_MISMATCH, PARSE, STATE, TIMEOUT,
          STALE) returned by nearly every libsig function. A header of types
          only, so it has no functions.
        '
      }

      refcount = component 'Reference counts' {
        technology 'sig_atomic.h'
        description '
          sig_refcount_h, a 16-bit counter over C11 atomics
          (sig_refcount_init/get/add/del). Safe to adjust from several
          threads; it protects the count only, not the object it counts.
        '
      }

      containers = component 'Hash table and list' {
        technology 'sig_ht.h, sig_ll.h'
        description '
          sig_ht (string-keyed hash table) and sig_ll (doubly linked list), each
          with an optional element destructor and a reference count. Neither is
          internally synchronized: the reference count only decides who tears the
          container down, so a container touched from more than one thread needs
          a caller-owned mutex (for example sig_mutex).
        '
      }

      logging = component 'Logging' {
        technology 'sig_log.h'
        description '
          Levelled logging (sig_log_trace .. sig_log_fatal) to a FILE*, which may
          be NULL to disable output. Each write is serialized by an internal
          mutex. sig_log_init must run before any thread that logs is spawned, and
          sig_log_shutdown only after every logging thread has been joined;
          concurrent init or shutdown is undefined behaviour.
        '
      }

      values = component 'Values' {
        technology 'sig_value.h'
        description '
          sig_value: int, bool, double, string, bytes, and map and list containers
          (backed by sig_ht and sig_ll). Strings, bytes and containers are
          reference counted; sig_value_copy shares them and sig_value_dup deep
          copies. A shared container is frozen: mutators return SIG_ERR_STATE
          until the other handles are released or the value is duplicated. A
          container must be mutated by one thread at a time; no locking is
          added. Nesting is limited to SIG_VALUE_MAX_DEPTH (32) for dup and
          JSON.
        '
      }

      json = component 'JSON' {
        technology 'sig_json.h, sig_value_json.h'
        description '
          sig_json is a streaming JSON writer (an allocation failure is sticky and
          reported by sig_json_finish). sig_value_to_json and sig_value_from_json
          convert sig_value trees to and from strict RFC 8259 JSON; map keys are
          written sorted and bytes become a base64 string (one-way). No shared
          state: a writer or value is used by one thread at a time.
        '
      }

      expressions = component 'Expressions' {
        technology 'sig_expr.h'
        description '
          A small condition language (for example input.reading.temp > 21.5)
          compiled once with sig_expr_compile and evaluated against a sig_value
          with sig_expr_eval_bool. A compiled sig_expr is immutable, evaluating
          it allocates nothing and is safe from several threads at once. An
          expression with no value for a given input reports
          SIG_ERR_TYPE_MISMATCH.
        '
      }

      python = component 'Python bindings' {
        technology 'sig_value_python.h'
        description '
          sig_value_to_pyobject and sig_value_from_pyobject convert between
          sig_value and PyObject. Built into sig::sig only with
          -DSIG_PYTHON_BINDINGS=ON (default OFF), which needs Python 3
          development files. The header states no threading rules; callers
          follow the Python interpreter rules.
        '
      }
    }
  }

  sig.foundation.containers -[calls]-> sig.foundation.allocation 'allocates nodes and buckets'
  sig.foundation.containers -[calls]-> sig.foundation.refcount 'counts references'
  sig.foundation.values -[calls]-> sig.foundation.containers 'maps and lists are a sig_ht and a sig_ll'
  sig.foundation.values -[calls]-> sig.foundation.allocation 'allocates strings and bytes'
  sig.foundation.values -[calls]-> sig.foundation.refcount 'counts references to shared payloads'
  sig.foundation.values -[calls]-> sig.foundation.logging 'logs refused mutations at debug level'
  sig.foundation.json -[calls]-> sig.foundation.allocation 'grows output buffers'
  sig.foundation.json -[calls]-> sig.foundation.values 'walks and builds sig_value trees'
  sig.foundation.expressions -[calls]-> sig.foundation.allocation 'compiles to heap nodes'
  sig.foundation.expressions -[calls]-> sig.foundation.values 'evaluates against a sig_value'
  sig.foundation.python -[calls]-> sig.foundation.values 'converts sig_value trees'
  sig.foundation.logging -[calls]-> sig.platform.threads 'serializes writes with a sig_mutex'
}

views {
  view foundation {
    title 'Foundation'
    include sig.foundation, sig.foundation.*
  }

  view foundation_components of sig.foundation {
    title 'Foundation components'
    include *
  }
}
