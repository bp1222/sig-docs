// HTTP: include/sig/http/sig_http_server.h, sig_http_client.h, sig_ws.h
// (src/http/sig_http_server.c, sig_http.c + sig_http.h [private], sig_ws.c,
// sig_http_client_curl.c). The server and the client are separate CMake targets;
// the area groups them. Build options (CMakeLists.txt:20-35,125-182): SIG_NET builds
// sig::net; SIG_HTTP_SERVER (requires SIG_NET) builds sig_http.c, sig_http_server.c and
// sig_ws.c as sig::http_server; SIG_HTTP_CLIENT builds sig_http_client_curl.c as
// sig::http_client and needs libcurl (find_package(CURL REQUIRED)). All are OFF by default.
//
// Sources (everything below was checked against these):
//   include/sig/http/sig_http_server.h               the long header comment: one server per runtime, modules registered AFTER it look it up in create();
//                                                    listens only if a prefix was registered; loop vs thread; config keys; the error replies; stop order;
//                                                    upgrade hand-off rules; "no authentication in v1 (see request_authorized())"
//   src/http/sig_http_server.c:32-54                 struct sig_http_server: routes, upgrades, started, listening, listener, thread, atomic stop, loop,
//                                                    listener_watch, listener_paused, conns, nconns
//   src/http/sig_http_server.c:73-126                parse_config: defaults bind 127.0.0.1, port 8080, timeout_ms 5000, no cors; unknown key or bad value is
//                                                    SIG_ERR_INVALID_ARG; cors_origin rejects CR or LF; timeout_ms 1..600000
//   src/http/sig_http_server.c:130-162               prefix_matches at a '/' boundary; find_route and find_upgrade_route take the longest prefix
//   src/http/sig_http_server.c:166-173               request_authorized(): ignores both arguments and returns true. It is the only authorization check in the server
//   src/http/sig_http_server.c:231,264-371           evaluate_request: parse; 400/431/413; wait for the full body; request_authorized (401 branch
//                                                    exists but cannot be taken while the function returns true); 411/415 for PUT/PATCH; OPTIONS 204 with
//                                                    cors else 405; WebSocket upgrade (400 bad version or key, 403 origin) only if an upgrade prefix matches
//                                                    and the method is GET; else find_route (404), run the handler, a non-OK handler status is 500
//   src/http/sig_http_server.c:405-436              threaded read_more: total deadline from the start of the request, 100 ms slices
//   src/http/sig_http_server.c:454-526              handle_conn and server_main: one connection at a time on the single server thread; the thread polls accept with
//                                                    a 100 ms timeout and the atomic stop flag; an adopted connection is not closed
//   src/http/sig_http_server.c:538-541              HTTP_MAX_CONNS 4, HTTP_INITIAL_BUF 1024, HTTP_DRAIN_MS 100, HTTP_DRAIN_MAX 65536
//   src/http/sig_http_server.c:529-800              loop transport: http_conn state machine READING/WRITING/DRAINING, one timer per phase
//   src/http/sig_http_server.c:824-849              listener_event: at nconns >= 4 the listener watch is set to 0 events and resumed when a connection is released
//   src/http/sig_http_server.c:851-858               loop_transport_stop closes the connections and removes the listener watch
//   src/http/sig_http_server.c:953-988              server_start: sets started, logs and returns OK with no routes and no upgrades; otherwise sig_net_listen, warns when bind is not "127.*", then
//                                                    sig_loop_watch_fd (loop) or sig_thread_create (no loop)
//   src/http/sig_http_server.c:991-1007              server_stop: closes loop connections, sets the stop flag and joins the thread, closes the listener
//   src/http/sig_http_server.c:1034-1060             the runtime module "http_server": create takes sig_runtime_loop(rt), start, stop, destroy
//   src/http/sig_http.h                              SIG_HTTP_MAX_HEAD 8192, SIG_HTTP_MAX_TARGET 512, SIG_HTTP_MAX_BODY 8192; the request struct
//   src/http/sig_http.c:37-102                       request line: upper-case method, target starts with '/', HTTP/1.0 or 1.1, query and fragment removed; a target over 512 is TOO_LARGE
//   src/http/sig_http.c:180-246                      headers: Transfer-Encoding is BAD; Content-Length up to 9 digits, conflicting duplicates BAD; Content-Type kept
//   src/http/sig_http.c:248-296                      parse_head: no blank line yet is INCOMPLETE, or TOO_LARGE once 8192 bytes were seen; ws_upgrade when Upgrade and Connection agree
//   src/http/sig_http.c:341-397                      sig_http_format_response: Content-Type application/json, Content-Length, Connection: close, Cache-Control: no-store;
//                                                    CORS headers only when a cors origin is configured (Allow-Methods, Allow-Headers, Max-Age only on a 204)
//   src/http/sig_ws.c:8-135                          own SHA-1 + base64 for Sec-WebSocket-Accept (RFC 6455 GUID)
//   src/http/sig_ws.c:140-245                        sig_ws_encode (unmasked, unfragmented) and sig_ws_decode (masked client frames only; text, close, ping, pong; protocol error for
//                                                    fragmentation, reserved bits, unmasked frames, control frames over 125 bytes)
//   src/http/sig_http_client_curl.c:18-117           curl_global_init once (pthread_once); sig_http_client_get: timeout_ms must be positive, no redirects, HTTP status other than
//                                                    200 is SIG_ERR_PLATFORM, body capped at SIG_HTTP_CLIENT_MAX_BODY (65536), CURLE_OPERATION_TIMEDOUT is SIG_ERR_TIMEOUT
//   src/http/sig_http_client_curl.c:119-180          sig_http_get_async: one detached pthread per request runs the blocking get, then calls done on that thread; pthread is used directly
//   capsules/weather/weather_capsule.c:54-61         the only non-test user: the weather capsule holds sig_http_get_async as its transport (replaceable for tests); no code in src/ or host/ calls the client
model {
  extend sig {
    http = module 'HTTP' {
      technology 'sig_http_server.h, sig_ws.h, sig_http_client.h; sig::http_server (SIG_HTTP_SERVER, needs SIG_NET) and sig::http_client (SIG_HTTP_CLIENT, libcurl)'
      description '
        The HTTP layer, in two independent parts. The server is one shared HTTP/1.1
        server per runtime, offered as a runtime module named http_server (build
        options SIG_NET and SIG_HTTP_SERVER); other modules register path prefixes
        on it. The client is a blocking and an asynchronous GET over libcurl (build
        option SIG_HTTP_CLIENT). The server has no TLS and no authentication.
      '

      server = component 'Server module' {
        technology 'sig_http_server_module, sig_http_server_register, sig_http_server_register_upgrade; SIG_HTTP_SERVER'
        description '
          The runtime module that owns the server, created with a space separated
          key=value config: bind (default 127.0.0.1), port (default 8080, 0 for
          an ephemeral port), cors_origin, and timeout_ms (default 5000, up to
          600000). An unknown key or a bad value fails module creation with
          SIG_ERR_INVALID_ARG. The server listens at start only if at least one
          route or upgrade prefix was registered; otherwise it logs and does
          nothing, and a bad bind address then goes unnoticed. A bind that does not
          start with "127." logs a warning that the unauthenticated API is
          reachable from the network. Modules registered after it find the server
          with sig_http_server_from_runtime during their create and register
          prefixes; registration after start is SIG_ERR_STATE and a duplicate
          prefix is SIG_ERR_EXISTS. Modules stop in reverse registration order, so
          the server is still serving while the stop hooks of the modules that
          registered routes run.
        '
      }

      dispatch = component 'Request evaluation and routing' {
        technology 'evaluate_request, find_route, request_authorized in sig_http_server.c'
        description '
          The protocol part shared by both transports. It parses the head, answers
          400, 431 or 413 for malformed or oversize requests (head over 8192 bytes,
          target over 512, Content-Length over 8192), waits for the whole body, runs
          request_authorized(), requires Content-Length and a JSON Content-Type on
          PUT and PATCH (411, 415), answers OPTIONS with 204 when cors_origin is set
          and 405 otherwise, and routes by the longest registered prefix that
          matches at a slash boundary (404 if none). A handler that returns a status
          other than SIG_OK produces 500; the server frees the response body. A
          GET with Upgrade: websocket and Connection: Upgrade goes to the upgrade
          table when an upgrade prefix matches (400 for a version other than 13 or no
          key, 403 when an Origin header does not equal cors_origin or "*"; no Origin
          header is allowed); with no matching upgrade prefix it is routed as an
          ordinary GET. request_authorized() ignores its arguments and returns true,
          so the server has no authentication; it is the single place a check would
          go.
        '
      }

      threaded = component 'Threaded transport' {
        technology 'server_main, handle_conn; sig_thread, blocking sig_net calls'
        description '
          Used when the runtime has no event loop. One server thread accepts with a
          100 ms timeout, so it sees the stop flag, and serves one connection at a
          time, start to finish, with one request per connection. The whole request
          must arrive within timeout_ms (else 408), and each write has the same
          timeout (100 ms once stopping). After a 400, 431 or 413 reply (the only ones
          marked to drain) it briefly reads and discards what the client is still
          sending so the client reads the reply and not a reset. Handlers run on this thread. An upgrade handler that returns
          SIG_OK owns the connection; any other status is a 503.
        '
      }

      looped = component 'Event-loop transport' {
        technology 'listener_event, conn_event; sig_loop watches and timers'
        description '
          Used when the runtime has a loop. The server owns no thread: the listener
          and each connection are fd watches on the loop, and handlers run on the
          loop thread. Each connection is a READING, WRITING or DRAINING state
          machine with one timer for its current phase (timeout_ms; 100 ms for
          draining, which only follows a 400, 431 or 413 reply, up to 64 KiB
          discarded), so a slow client costs a buffer and a
          timer, not the loop. At most four connections are open; at four the
          listener is unwatched, leaving further clients queued in the kernel, and it
          is watched again when a connection closes. A request that times out while
          reading gets a best-effort 408. An accepted upgrade removes the watch and
          timer and hands over the non-blocking connection.
        '
      }

      parser = component 'Request parser and response formatter' {
        technology 'sig_http.c, sig_http.h; private, in sig::http_server'
        description '
          Pure functions over buffers. sig_http_parse_head reads the request line
          and headers: it accepts HTTP/1.0 and 1.1, removes the query and fragment
          from the path, rejects Transfer-Encoding and conflicting Content-Length
          values, and keeps Content-Type, Content-Length and the WebSocket headers
          (Upgrade, Connection, Sec-WebSocket-Key, Sec-WebSocket-Version, Origin). It
          answers INCOMPLETE until the blank line arrives. sig_http_format_response
          builds a JSON response with Content-Length, Connection: close and
          Cache-Control: no-store, and adds Access-Control-Allow-Origin when
          cors_origin is set, and the allowed methods and headers on a 204.
        '
      }

      ws = component 'WebSocket primitives' {
        technology 'sig_ws.h, sig_ws.c; part of sig::http_server'
        description '
          Handshake and framing, as pure functions with no sockets. The accept key is
          SHA-1 and base64 of the client key plus the RFC 6455 GUID. Server frames are
          unmasked and unfragmented text, close, ping or pong. The decoder takes
          masked client frames from a buffer and unmasks them in place; it reports an
          incomplete frame, a payload over a limit, or a protocol error (unmasked,
          fragmented, reserved bits, unknown opcode, or a control frame over 125
          bytes).
        '
      }

      client = component 'HTTP client' {
        technology 'sig_http_client_curl.c; libcurl; SIG_HTTP_CLIENT'
        description '
          sig_http_client_get is a blocking GET with a positive millisecond timeout.
          It does not follow redirects, treats any HTTP status other than 200 as
          SIG_ERR_PLATFORM, and refuses a body over 64 KiB. sig_http_get_async starts
          one short-lived detached thread per request that runs the same transfer and
          then calls done on that thread. The header promises that done never runs
          before sig_http_get_async returns, but the curl port does not enforce it
          (there is no handshake with the caller), so a fast failure can run done
          on the request thread before the call returns. There is no cancel. The client does not use the server, the socket layer or the event
          loop. In this repository its user is the weather capsule.
        '
      }
    }
  }

  sig.http.server -[calls]-> sig.runtime.modules 'registered as the runtime module "http_server"; create, start, stop and destroy hooks'
  sig.http.server -[calls]-> sig.http.dispatch 'both transports evaluate each request through it'
  sig.http.server -[calls]-> sig.http.threaded 'starts the server thread when the runtime has no loop; sets the stop flag and joins at stop'
  sig.http.server -[calls]-> sig.http.looped 'watches the listener on the loop when the runtime has one'
  sig.http.server -[calls]-> sig.platform.net 'sig_net_listen at start; closes the listener at stop'
  sig.http.server -[calls]-> sig.platform.threads 'sig_thread_create and sig_thread_join for the server thread'
  sig.http.server -[calls]-> sig.foundation.logging 'logs listening, no routes, and the non-loopback bind warning'
  sig.http.server -[calls]-> sig.foundation.allocation 'allocates the server and the route tables'
  sig.http.threaded -[calls]-> sig.http.dispatch 'evaluate_request for each connection'
  sig.http.threaded -[calls]-> sig.platform.net 'sig_net_accept, sig_net_read, sig_net_write_all with timeouts'
  sig.http.threaded -[calls]-> sig.platform.time 'sig_time_now for the request deadline'
  sig.http.looped -[calls]-> sig.http.dispatch 'evaluate_request when a readable event has data'
  sig.http.looped -[calls]-> sig.runtime.loop 'sig_loop_watch_fd, sig_loop_watch_modify, sig_loop_timer_start for connections and the listener'
  sig.http.looped -[calls]-> sig.platform.poller 'SIG_POLL_READ and SIG_POLL_WRITE event masks for its watches'
  sig.http.looped -[calls]-> sig.platform.net 'non-blocking accept, read and write (timeout 0)'
  sig.http.looped -[calls]-> sig.platform.time 'sig_time_now for the phase deadline'
  sig.http.dispatch -[calls]-> sig.http.parser 'sig_http_parse_head and sig_http_format_response'
  sig.http.client -[calls]-> sig.foundation.allocation 'response buffer'
  sig.http.client -[calls]-> sig.foundation.logging 'debug line on a failed transfer'
}

views {
  view http {
    title 'HTTP'
    include sig.http, sig.http.*
  }

  view http_components of sig.http {
    title 'HTTP components'
    include *
  }
}
