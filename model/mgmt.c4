// Management: include/sig/mgmt/sig_mgmt.h, sig_mgmt_http.h (src/mgmt/sig_mgmt.c, sig_mgmt_http.c,
// sig_mgmt_rest.c + sig_mgmt_rest.h [private], sig_mgmt_limits.h). Build options (CMakeLists.txt:113-123,
// 184-196): SIG_MGMT builds sig_mgmt.c as sig::mgmt; sig::mgmt_http (sig_mgmt_http.c and sig_mgmt_rest.c) is built
// whenever SIG_MGMT and SIG_HTTP_SERVER are both ON and has no option of its own. Both are OFF by default.
//
// Sources (everything below was checked against these):
//   include/sig/mgmt/sig_mgmt.h                     transport-neutral contract; "Locking" and "Actions" and "Edits" paragraphs; error table
//   include/sig/mgmt/sig_mgmt_http.h                glue module: routes the "/" prefix of the shared server to mgmt; registration order; no config
//   src/mgmt/sig_mgmt.c:14-19                       struct sig_mgmt: runtime, started_at, one sig_rwlock
//   src/mgmt/sig_mgmt.c:196-283                     edit_ctx and the edit_* callbacks, which run under sig_runtime_edit and call the sig_project_put/patch/delete/rename functions
//   src/mgmt/sig_mgmt.c:372-391                     mgmt_uptime uses its own start time because sig_runtime_uptime_seconds would take the runtime control lock
//   src/mgmt/sig_mgmt.c:392-828                     build_* read builders: sorted lists, deep copies, run under the shared lock; project NULL gives SIG_ERR_STATE
//   src/mgmt/sig_mgmt.c:821-890                     READ_OP: sig_rwlock_rdlock around each build_*
//   src/mgmt/sig_mgmt.c:890-1004                    build_state, START_TRIES 8, needs_rebuild (shared lock), prepare_service (exclusive lock + sig_runtime_edit + sig_project_refresh_service),
//                                                   start_prebuilt (retry on SIG_ERR_STALE, then SIG_ERR_STATE), service_action: start = start_prebuilt; stop = sig_runtime_service_stop;
//                                                   restart = stop then start_prebuilt; mgmt never calls sig_runtime_service_start
//   src/mgmt/sig_mgmt.c:1018-1024                   sig_mgmt_request_shutdown calls sig_runtime_request_shutdown
//   src/mgmt/sig_mgmt.c:1026-1048                   edit_locked: sig_rwlock_wrlock around sig_runtime_edit; errmsg filled only for SIG_ERR_PARSE and SIG_ERR_EXISTS
//   src/mgmt/sig_mgmt.c:1087-1170                   write_op, delete_op, rename: empty document is SIG_ERR_INVALID_ARG "document required"; new name of 80 bytes or more refused
//   src/mgmt/sig_mgmt.c:1175-1221                   module "mgmt": create (start time, rwlock), no start or stop hook, destroy; sig_mgmt_from_runtime
//   src/mgmt/sig_mgmt_http.c:11-69                  glue: glue_create looks up http_server and mgmt, registers "/" with handle(); no start/stop/destroy hooks; config must be NULL or ""
//   src/mgmt/sig_mgmt_rest.c:49-196                 JSON rendering of the operation trees (emit_value: bytes, maps and lists inside a property value become null; doubles in "config" keep a '.')
//   src/mgmt/sig_mgmt_rest.c:198-245                status mapping tables op_error, read_error, edit_error
//   src/mgmt/sig_mgmt_rest.c:356-366                POST /system/shutdown answers 202 {"status":"shutting_down"}
//   src/mgmt/sig_mgmt_rest.c:374-427                PUT answers 201 for a created object and 200 for a replaced one; empty body is 400; delete answers {"name","deleted":true}
//   src/mgmt/sig_mgmt_rest.c:490-510                the route table: 19 routes of 1 to 4 segments
//   src/mgmt/sig_mgmt_rest.c:556-592                split_path splits on '/' first, then percent-decodes each segment; more than 4 segments is 404; a bad escape is 400
//   src/mgmt/sig_mgmt_rest.c:610-673                sig_mgmt_rest_handle: a matching path with another method is 405, no matching path is 404
//   src/http/sig_http_server.c:166-173,305-308      request_authorized() in the HTTP server is the only authorization hook; it returns true. Nothing in src/mgmt or src/feed
//                                                   mentions authentication (grep for "auth")
//   src/http/sig_http_server.c:348-370              the server runs the handler registered for "/"; a non-OK handler status is 500
//   src/runtime/sig_runtime.c:523-537               sig_runtime_edit: ctl_mtx, SIG_ERR_STATE unless RUNNING
//   src/runtime/sig_runtime.c:577-640               service control (start_prebuilt answers SIG_ERR_STALE when the service went dirty again)
//   src/project/sig_project.c:618-690,1138-1192     put_configuration and put_service: parse (a trial build for a service), validate against the property table, save, then replace and
//                                                   refresh stopped services; patch merges the JSON patch over the stored text and calls put
//   src/project/sig_project.c:1081-1136,1263-1296   entry_dirty, rebuild_live (re-parses the stored definition text, it does not reload from the store), refresh_service
//   docs/architecture.md                            sequence diagram "Editing" (lines 219-234) compared with the code, see the edit_and_restart view
//   docs/architecture.md                            "mgmt_http" registration order (http_server, mgmt, mgmt_http) agrees with sig_mgmt_http.h
model {
  extend sig {
    mgmt = module 'Management' {
      technology 'sig_mgmt.h, sig_mgmt_http.h; sig::mgmt (SIG_MGMT) and sig::mgmt_http (built when SIG_MGMT and SIG_HTTP_SERVER are both on)'
      description '
        Reads and controls a running runtime. The operations in sig::mgmt take and
        return plain value trees and status codes and know nothing of any
        transport. The REST layer and the glue module in sig::mgmt_http map HTTP
        onto them, on the shared HTTP server. Built when SIG_MGMT is ON; the HTTP
        part is built when SIG_MGMT and SIG_HTTP_SERVER are both ON. There is no
        authentication anywhere in the area.
      '

      module = component 'Mgmt module' {
        technology 'sig_mgmt_module; SIG_MGMT'
        description '
          The runtime module named "mgmt". Its create hook records the start time
          and initialises the one reader-writer lock; it has no start or stop hook
          and its destroy hook frees the state. The state is found by other
          modules with sig_mgmt_from_runtime after it is created, so it must be
          registered before the glue module.
        '
      }

      reads = component 'Read operations' {
        technology 'sig_mgmt_system, list_*, get_*; build_* in sig_mgmt.c'
        description '
          Each read takes the shared lock, builds a fresh tree and releases the lock.
          The tree is a deep copy with no pointers into runtime state, lists are
          sorted by name, and concurrent readers do not block each other. A read
          that finds no project is SIG_ERR_STATE. A name that does not name an
          object is SIG_ERR_NOT_FOUND. The uptime is computed from a start time
          kept in the module, so a read never takes the runtime control lock and is
          not stalled behind a slow service start.
        '
      }

      actions = component 'Service actions' {
        technology 'sig_mgmt_start/stop/restart_service, request_shutdown'
        description '
          The hooks of a service run with none of the mgmt lock held. Start never
          calls the runtime start that rebuilds: it first rebuilds a stopped, dirty
          service in a short exclusive section (the old service is freed, which no
          reader may be walking), then calls the runtime start for a prebuilt
          service, which answers SIG_ERR_STALE if the service went dirty again; the
          pair is retried up to 8 times and then reported as SIG_ERR_STATE. Restart
          is a stop followed by that start, not one atomic call, so a concurrent
          start can win in between and a failed rebuild or start leaves the service
          stopped. Stopping a stopped service succeeds. Each action returns the new
          name and state. The shutdown request only records the request in the
          runtime.
        '
      }

      edits = component 'Edit operations' {
        technology 'sig_mgmt_put/patch/delete/rename_*; edit_locked'
        description '
          Each edit takes the exclusive lock and runs one project editing function
          inside sig_runtime_edit, so edits wait for in-flight readers and for the
          runtime control lock. The project validates the document and writes it
          to the store; mgmt copies out the resulting definition text and builds
          the result tree after the lock is released. If the project reports a
          failure, nothing was changed (the one exception is SIG_ERR_ALLOC while
          building the result, after the edit was applied). The reason text is
          returned only for a rejected configuration document or a rename onto a
          taken name. A put or patch does not touch a running service; it is
          reported dirty until it is stopped and rebuilt. Deleting a service stops
          and destroys it even if it is running.
          The shared header notes that an edit waiting behind a slow service start
          holds the exclusive lock, so reads stall until that start returns.
        '
      }

      rest = component 'REST router' {
        technology 'sig_mgmt_rest_handle, route table, split_path in sig_mgmt_rest.c; private'
        description '
          Turns a method, a path and a body into one operation call. The route
          table has 19 routes of up to four segments: system, services (with
          instances, config, start, stop, restart), capsules, configurations
          (with rename) and system/shutdown. A PUT that creates an object answers
          201 and one that replaces it 200. A path is split on slash first and
          each segment then percent-decoded, so an encoded slash cannot create a
          segment. A malformed escape is 400, more than four segments or no
          matching path is 404, and a matching path with another method is 405.
          PUT, PATCH and the rename route need a body (400 otherwise). Nothing here
          touches runtime or project state.
        '
      }

      status = component 'Status mapping and JSON rendering' {
        technology 'op_error, edit_error, emit_tree in sig_mgmt_rest.c; private'
        description '
          Maps operation statuses to HTTP, per kind of operation. Reads and actions:
          not found 404, an already running service 409, SIG_ERR_STATE 503
          ("runtime is not running", which is also what a start that was
          overtaken 8 times or a missing project produces), and for actions
          SIG_ERR_INVALID_ARG 422 (a capsule configuration is invalid), anything
          else 500. Edits: SIG_ERR_INVALID_ARG 400, a document that failed
          validation 422, not found 404, a configuration in use or a name taken
          409, SIG_ERR_STATE 503, anything else 500. Errors are {"error": code, "message": text}. Result trees are written
          as JSON; a property value of kind bytes, map or list is written as null.
        '
      }

      glue = component 'HTTP glue module' {
        technology 'sig_mgmt_http_module; SIG_MGMT and SIG_HTTP_SERVER'
        description '
          The runtime module named "mgmt_http". Its create hook finds the HTTP
          server and the mgmt state (both must be registered earlier, else start
          fails with the lookup status), refuses any config, and registers the "/"
          prefix on the server with a handler that calls the REST router and hands
          its body to the server. So every path of the server not taken by a longer
          prefix reaches the REST router. It has no start, stop or destroy hook.
          Authorization is not here: the server runs its request_authorized() check
          before any handler, and that check always accepts.
        '
      }
    }
  }

  sig.mgmt.module -[calls]-> sig.runtime.modules 'registered as the runtime module "mgmt"; create and destroy hooks only'
  sig.mgmt.module -[calls]-> sig.platform.threads 'sig_rwlock_init and destroy'
  sig.mgmt.module -[calls]-> sig.platform.time 'sig_time_now for the start time'
  sig.mgmt.reads -[calls]-> sig.platform.threads 'sig_rwlock_rdlock around every read'
  sig.mgmt.reads -[calls]-> sig.runtime.modules 'sig_runtime_walk_modules for the module names'
  sig.mgmt.reads -[calls]-> sig.project.introspection 'walks and looks up services and configurations, and copies their stored definitions'
  sig.mgmt.reads -[calls]-> sig.project.dirty 'sig_project_service_dirty for the dirty flag'
  sig.mgmt.reads -[calls]-> sig.service.instances 'walks the instances of a service, its name, its running flag'
  sig.mgmt.reads -[calls]-> sig.capsules.registry 'walks the registered capsules and their property tables'
  sig.mgmt.reads -[calls]-> sig.capsules.instance 'instance name, configuration, type and terminals'
  sig.mgmt.reads -[calls]-> sig.capsules.routes 'sig_capsule_instance_walk_routes for the links of a service'
  sig.mgmt.reads -[calls]-> sig.capsules.configuration 'walks the property values of an instance'
  sig.mgmt.reads -[calls]-> sig.foundation.values 'builds the result trees with sig_value maps and lists'
  sig.mgmt.actions -[calls]-> sig.runtime.control 'sig_runtime_service_stop, sig_runtime_service_start_prebuilt and sig_runtime_edit (for the rebuild)'
  sig.mgmt.actions -[calls]-> sig.runtime.shutdown 'sig_runtime_request_shutdown'
  sig.mgmt.actions -[calls]-> sig.project.dirty 'sig_project_refresh_service rebuilds a stopped, dirty service'
  sig.mgmt.actions -[calls]-> sig.platform.threads 'shared lock for the lookup, exclusive lock for the rebuild'
  sig.mgmt.actions -[calls]-> sig.mgmt.reads 'builds the returned {name, state} tree under the shared lock'
  sig.mgmt.edits -[calls]-> sig.runtime.control 'sig_runtime_edit runs the project edit under the control lock'
  sig.mgmt.edits -[calls]-> sig.project.editing 'sig_project_put/patch/delete_* and rename_configuration'
  sig.mgmt.edits -[calls]-> sig.project.dirty 'sig_project_service_dirty for the dirty flag of a service result'
  sig.mgmt.edits -[calls]-> sig.platform.threads 'sig_rwlock_wrlock around the edit'
  sig.mgmt.edits -[calls]-> sig.foundation.values 'builds the result tree from the definition text'
  sig.mgmt.rest -[calls]-> sig.mgmt.reads 'GET routes'
  sig.mgmt.rest -[calls]-> sig.mgmt.actions 'POST start, stop, restart and shutdown routes'
  sig.mgmt.rest -[calls]-> sig.mgmt.edits 'PUT, PATCH, DELETE and rename routes'
  sig.mgmt.rest -[calls]-> sig.mgmt.status 'maps statuses to HTTP and renders the result tree'
  sig.mgmt.status -[calls]-> sig.foundation.json 'sig_json writer, sig_value_from_json for the rename body'
  sig.mgmt.glue -[calls]-> sig.mgmt.rest 'the registered handler calls sig_mgmt_rest_handle'
  sig.mgmt.glue -[calls]-> sig.http.server 'sig_http_server_from_runtime and sig_http_server_register("/") in its create hook'
  sig.mgmt.glue -[calls]-> sig.mgmt.module 'sig_mgmt_from_runtime in its create hook'
  sig.mgmt.glue -[calls]-> sig.runtime.modules 'registered as the runtime module "mgmt_http"; create hook only'
  sig.http.dispatch -[calls]-> sig.mgmt.glue 'runs the handler registered for the longest matching prefix, "/" here'
}

views {
  view mgmt {
    title 'Management'
    include sig.mgmt, sig.mgmt.*
  }

  view mgmt_components of sig.mgmt {
    title 'Management components'
    include *
  }

  dynamic view edit_and_restart {
    title 'Edit a configuration, then restart the service'
    description 'Two REST requests from a client. The edit (PATCH /configurations/Sim) validates and saves the document and marks the services that use it dirty, but does not touch a running service. The restart (POST /services/test/restart) stops it, rebuilds it from its in-memory definition (the edit already updated it) and starts it. Checked against sig_mgmt.c, sig_runtime.c, sig_project.c and the persistence file backend.'

    sig.http.dispatch -> sig.mgmt.glue 'PATCH /configurations/Sim: the server has read the whole request, request_authorized() accepted it, and the longest matching prefix is "/", whose handler is the glue'
    sig.mgmt.glue -> sig.mgmt.rest 'sig_mgmt_rest_handle(method, path, body) splits and decodes the path and finds the PATCH route (400 if the body is empty)'
    sig.mgmt.rest -> sig.mgmt.edits 'sig_mgmt_patch_configuration: the exclusive mgmt lock is taken, so in-flight reads drain first'
    sig.mgmt.edits -> sig.runtime.control 'sig_runtime_edit runs the project edit under the runtime control mutex (SIG_ERR_STATE if the runtime is not RUNNING)'
    sig.runtime.control -> sig.project.editing 'sig_project_patch_configuration: the JSON patch is merged over the stored text, then put_configuration runs'
    sig.project.editing -> sig.project.parser 'the merged document is parsed exactly as at load, then checked against the property table of its capsule (sig_capsule_configuration_validate); nothing is written if either fails (422 with the reason)'
    sig.project.editing -> sig.persistence.store 'save_doc: the document plus a newline goes to sig_persistence_save("configurations", "Sim")'
    sig.persistence.store -> sig.persistence.file 'the namespace and key are checked against the file backend rules, and the "configurations" namespace maps to the .cfg extension'
    sig.persistence.file -> sig.persistence.atomic 'the file backend writes Sim.cfg.tmp, fsyncs it and renames it over Sim.cfg; on failure the old file and the old definition stay'
    sig.project.editing -> sig.project.dirty 'the sequence number is bumped, so every service that uses Sim is dirty. A stopped service is rebuilt right away; a running one keeps its old instances'
    sig.mgmt.rest <- sig.mgmt.edits 'the exclusive lock is released, then the result {name, config} is built from the copied text; 200 with the new document'
    sig.http.dispatch -> sig.mgmt.glue 'POST /services/test/restart arrives the same way'
    sig.mgmt.glue -> sig.mgmt.rest 'matched against POST /services/:name/restart'
    sig.mgmt.rest -> sig.mgmt.actions 'sig_mgmt_restart_service holds none of the mgmt lock while the hooks run'
    sig.mgmt.actions -> sig.runtime.control 'sig_runtime_service_stop under the control mutex'
    sig.runtime.control -> sig.service.lifecycle 'sig_service_stop: the worker is joined first, then the stop hooks run on the calling thread'
    sig.mgmt.actions -> sig.project.dirty 'prepare_service: still dirty and stopped, so under the exclusive lock and sig_runtime_edit, sig_project_refresh_service rebuilds the service from its stored definition text (memory, not a reload from disk)'
    sig.mgmt.actions -> sig.runtime.control 'sig_runtime_service_start_prebuilt (SIG_ERR_STALE would send it back to the rebuild, up to 8 times)'
    sig.runtime.control -> sig.service.lifecycle 'sig_service_start: start hooks on the calling thread, then the worker thread is spawned'
    sig.mgmt.actions -> sig.mgmt.reads 'the {name, state} result is built under the shared lock and returned with 200; it carries no dirty flag'
  }
}
