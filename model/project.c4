// Project: include/sig/project/sig_project.h, sig_config.h (src/project/sig_project.c,
// sig_config.c). The persistence store the project reads and writes is a separate
// area and is not modelled here; its use appears in the descriptions.
//
// Sources (everything below was checked against these):
//   include/sig/project/sig_project.h        load / destroy / start_auto / stop_all / walk comments; the "Editing" block (names, validation,
//                                            "Not thread-safe on their own", retired configurations); dirty and refresh comments
//   include/sig/project/sig_config.h         every declaration is SIG_PRIVATE (no public function in the parser)
//   src/project/sig_config.c:60-84           parse_document: sig_value_from_json, root must be an object
//   src/project/sig_config.c:121-182         configuration: "type" looked up in the capsule registry; optional "attr_value" object of scalars
//   src/project/sig_config.c:106-119         set_attr: int, bool, double, string only (anything else is SIG_ERR_PARSE)
//   src/project/sig_config.c:215-271,347-433 service: optional "auto_start" boolean, "execution" array; pass 1 instantiates each entry
//                                            (instance takes the configuration name, must name a known configuration), pass 2 wires "receivers"
//                                            ({terminal: [{name, input}]}) with sig_capsule_instance_connect
//   src/project/sig_project.c:14-50          service entry (service, owned instance list, auto_start, built_seq/def_gen, json, uses) and
//                                            configuration entry (owned configuration, json, gen); sig_retired list; project->seq bumped by edits
//   src/project/sig_project.c:75-90          service entry dtor: stop (no-op if never started), destroy instances, destroy service
//   src/project/sig_project.c:339-450        load_key loads one key via sig_persistence_load; load_namespace uses sig_persistence_list; a missing
//                                            namespace is empty; configurations load before services; any failure tears the project down
//   src/project/sig_project.c:398-408        teardown: services first (instances borrow configurations), then configurations, then retired ones
//   src/project/sig_project.c:483-542        start_auto and stop_all: best-effort across services, last failure returned
//   src/project/sig_project.c:559-570        walk_services
//   src/project/sig_project.c:618-690        put_configuration: parse, validate against the property table, save, replace; the old one goes to the retired list
//   src/project/sig_project.c:1081-1136      entry_dirty (def_gen or a used configuration newer than built_seq), rebuild_live (stopped services only)
//   src/project/sig_project.c:1138-1192      put_service builds a trial service as validation; replacing a service changes its definition and the live one is rebuilt only if stopped
//   src/project/sig_project.c:1220-1236      delete_service: removes the key and the entry (the dtor stops a running service)
//   src/project/sig_project.c:1263-1296      service_dirty and refresh_service
//   src/project/sig_project.c:105-130        valid_name: [A-Za-z0-9_-]{1,64}
//   src/project/sig_project.c:176-204        merge_json: sig_value_merge_patch over sig_value_from_json / sig_value_to_json
//   docs/architecture.md                     "Ownership" table and sig_project_destroy order, rule 6, "Editing and the dirty flag". The document says
//                                            destroy stops every service, then destroys instances, services and configurations "in that order"; the code does
//                                            that per service entry (stop, instances, service), then all configurations. Rule 6 says the sets are not
//                                            modified after load; the header says the service table is mutated only by load and destroy, but the editing
//                                            functions below do add, replace and remove entries at run time (serialized by sig_runtime_edit, which does not
//                                            exclude sig_mgmt readers, per sig_runtime.h). Stated here as the code behaves.
model {
  extend sig {
    project = module 'Project' {
      technology 'sig_project.h, sig_config.h; part of sig::sig'
      description '
        A project is the capsule configurations and services loaded from a
        persistence store and wired together. It owns the configurations,
        services and capsule instances it builds, keeps the JSON definition of
        each, and writes every edit back to the store. Nothing is started by
        loading. The store and the capsule registry are borrowed and must outlive
        the project.
      '

      parser = component 'Config parser' {
        technology 'sig_config.h; sig_value JSON; private functions'
        description '
          Turns one .cfg JSON document into live objects. A capsule configuration
          document names its capsule in "type" (looked up in the registry) and may
          carry an "attr_value" object whose values must be int, bool, double or
          string. A service document has an optional boolean "auto_start" and an
          "execution" array whose entries each name a capsule configuration; the
          instance takes that name. It works in two passes, so a receiver may name
          an entry listed later: first every entry is instantiated and added to the
          service, then every "receivers" object (output terminal to a list of
          name and input) is wired with sig_capsule_instance_connect. On failure
          nothing is left allocated. The functions in sig_config.h are SIG_PRIVATE,
          so this component has no public functions.
        '
      }

      loader = component 'Project load' {
        technology 'sig_project_load'
        description '
          Reads every key of the "configurations" namespace and then every key of
          the "services" namespace of the store, so services can resolve their
          configurations. A namespace the store does not have is empty, not an
          error; a key that vanishes between listing and loading is skipped; any
          other failure to list or load is SIG_ERR_PLATFORM, and a document that
          does not validate is SIG_ERR_PARSE or SIG_ERR_NOT_FOUND. On any failure
          everything built so far is torn down and no partial project is returned.
          Nothing is started by this call.
        '
      }

      ownership = component 'Ownership and auto-start' {
        technology 'sig_project_destroy/start_auto/stop_all'
        description '
          The project owns its capsule configurations, its services, and the
          capsule instances (kept in an owned list per service; services do not
          own their instances). sig_project_destroy stops each service, destroys
          its instances, destroys the service, and finally destroys the
          configurations (replaced or deleted ones are kept on a retired list until
          then, because a running service may still borrow them). start_auto starts
          every service flagged auto_start, and stop_all stops every service;
          both are best-effort across services: one failure does not stop the
          others, and the last failure is returned.
        '
      }

      introspection = component 'Walk and introspection' {
        technology 'sig_project_walk_*, get_*'
        description '
          Lookup of a service or a configuration by name, counting and walking
          services and configurations, the services that use a configuration, and
          the stored JSON of a definition. The header states that walking is
          read-only and safe from any thread once the project is loaded, and that a
          sig_service handed to a callback stays valid until the project is
          destroyed; order is unspecified. Caution: the editing functions can
          replace and remove services later, and sig_runtime_edit does not exclude
          readers that go through sig_mgmt.
        '
      }

      editing = component 'Editing' {
        technology 'sig_project_put_/patch_/delete_/rename_*'
        description '
          Creates, replaces, patches (JSON merge patch), deletes and renames
          configurations and services, saving each document to the store under its
          name followed by one newline. Names must match [A-Za-z0-9_-]{1,64}. A
          document is validated exactly as load would, and a configuration also
          against the property table of its capsule; on any failure nothing is
          saved and nothing changes, and sig_project_last_error gives the reason.
          Replacing or patching a service, and any configuration edit, leaves a
          running service running (it only becomes dirty); deleting a
          configuration that a service definition uses is refused with
          SIG_ERR_EXISTS. Deleting a service stops and destroys it, even if
          it is running. Not thread-safe on its
          own: callers serialize edits with each other and with service start and
          stop, which sig_runtime_edit does.
        '
      }

      dirty = component 'Dirty tracking' {
        technology 'sig_project_service_dirty/refresh_service'
        description '
          Every edit bumps a sequence number. A service is dirty when its
          definition, or the definition of a configuration it uses, changed after
          the live service was built. A stopped service is rebuilt immediately
          after an edit; a running one keeps its old instances and is reported
          dirty until it is stopped and refreshed, so an edit cannot half-apply.
          sig_project_refresh_service rebuilds a stopped, dirty service and
          invalidates earlier pointers to it; a running service is left alone.
        '
      }
    }
  }

  sig.project.loader -[calls]-> sig.project.parser 'parses each stored document: configurations first, then services'
  sig.project.loader -[calls]-> sig.foundation.logging 'logs load progress and failures'
  sig.project.loader -[calls]-> sig.foundation.allocation 'allocates the project and its tables'
  sig.project.parser -[calls]-> sig.foundation.json 'sig_value_from_json parses the document'
  sig.project.parser -[calls]-> sig.capsules.registry 'looks up the type of a configuration'
  sig.project.parser -[calls]-> sig.capsules.configuration 'creates a configuration and sets its properties'
  sig.project.parser -[calls]-> sig.capsules.instance 'creates one instance per execution entry'
  sig.project.parser -[calls]-> sig.capsules.routes 'wires receivers with sig_capsule_instance_connect'
  sig.project.parser -[calls]-> sig.service.lifecycle 'creates the service'
  sig.project.parser -[calls]-> sig.service.instances 'adds each instance to the service'
  sig.project.ownership -[owns]-> sig.service.lifecycle 'services; stopped before destroy'
  sig.project.ownership -[owns]-> sig.capsules.instance 'instances; services only borrow them'
  sig.project.ownership -[owns]-> sig.capsules.configuration 'configurations; instances borrow them'
  sig.project.ownership -[calls]-> sig.service.lifecycle 'start_auto, stop_all and destroy start and stop services'
  sig.project.editing -[calls]-> sig.project.parser 'validates a new document exactly as load does'
  sig.project.editing -[calls]-> sig.capsules.configuration 'validates properties against the capsule table'
  sig.project.editing -[calls]-> sig.project.dirty 'rebuilds stopped services after every edit'
  sig.project.editing -[calls]-> sig.foundation.json 'merge patch and renaming work on parsed JSON'
  sig.project.dirty -[calls]-> sig.project.parser 'rebuilds a stopped service from its definition'
}

views {
  view project {
    title 'Project'
    include sig.project, sig.project.*
  }

  view project_components of sig.project {
    title 'Project components'
    include *
  }
}
