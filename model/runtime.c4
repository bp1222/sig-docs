// Runtime: include/sig/runtime/sig_runtime.h, sig_loop.h, sig_tap.h
// (src/runtime/sig_runtime.c, sig_loop.c). sig_service.h and sig_capsule.h are
// separate areas (service.c4, capsules.c4) although they share the directory.
//
// Sources (everything below was checked against these):
//   include/sig/runtime/sig_runtime.h    state list "CREATED -> STARTING -> RUNNING -> STOPPING -> CREATED"; module hooks nullable except name;
//                                        start/stop semantics; "service-control lock"; thread restriction on sig_runtime_service_*,
//                                        uptime, dump_info, set_tap, find_terminal; sig_runtime_edit; set_loop / step
//   src/runtime/sig_runtime.c:15-20      rt_state_t RT_CREATED, RT_STARTING, RT_RUNNING, RT_STOPPING
//   src/runtime/sig_runtime.c:30-46      struct sig_runtime: ctl_mtx ("guards state; serializes service control"), shutdown_mtx + shutdown_cond,
//                                        loop (borrowed), tap_fn/tap_ctx "guarded by ctl_mtx"
//   src/runtime/sig_runtime.c:111-169    register_module: only in RT_CREATED (SIG_ERR_STATE), duplicate name SIG_ERR_EXISTS, config copied
//   src/runtime/sig_runtime.c:171-195    teardown_modules: stop every started module in reverse, then destroy every created module in reverse
//   src/runtime/sig_runtime.c:199-212    runtime_wake -> sig_loop_wake; configure_service: set_driven + set_wake only if a loop is set, set_tap always
//   src/runtime/sig_runtime.c:231-247    set_tap takes ctl_mtx, SIG_ERR_STATE unless RUNNING, walks every service
//   src/runtime/sig_runtime.c:249-281    find_terminal: input terminals are searched before output terminals (an input wins)
//   src/runtime/sig_runtime.c:327-368    step_walk steps running driven services; sig_runtime_step holds ctl_mtx across the walk
//   src/runtime/sig_runtime.c:370-450    start: STARTING, clears shutdown_requested, sig_project_load, create for every module then start for every module,
//                                        configure_service_walk, sig_project_start_auto (failure only logged), then RUNNING; unwind on failure
//   src/runtime/sig_runtime.c:452-492    stop: SIG_OK in CREATED, SIG_ERR_STATE unless RUNNING, STOPPING, sig_project_stop_all, clears the tap,
//                                        unlocks, teardown_modules, sig_project_destroy, CREATED
//   src/runtime/sig_runtime.c:494-517    request_shutdown: shutdown_mtx + condition notify, wakes the loop if set; wait blocks on the condition
//   src/runtime/sig_runtime.c:523-537    sig_runtime_edit runs fn(project) under ctl_mtx, SIG_ERR_STATE unless RUNNING
//   src/runtime/sig_runtime.c:577-630    service_control: ctl_mtx, RUNNING only; start/restart call sig_project_refresh_service then configure_service
//   src/runtime/sig_runtime.c:648-663    uptime_seconds takes ctl_mtx
//   src/runtime/sig_runtime.c:686-738    dump_info holds ctl_mtx for the whole dump
//   include/sig/runtime/sig_tap.h        SIG_TAP_INPUT before the handler runs, SIG_TAP_OUTPUT on notify (routed or not); must not block
//   src/feed/sig_feed_hub.c:318-330,415-455  the only caller of sig_runtime_set_tap: installs it on subscribe, removes it when the last subscription goes
//   include/sig/runtime/sig_loop.h       fd watches, one-shot timers, step hook; only sig_loop_wake and sig_loop_stop are callable from other threads
//   src/runtime/sig_loop.c:256-303       sig_loop_run: step, fire due timers, poller wait bounded by the step deadline and the next timer, dispatch
//   src/runtime/sig_loop.c:9-10          LOOP_MAX_EVENTS 16; sleep capped at 3600000 ms
//   src/runtime/sig_loop.c:1-5,55,291    includes sig_alloc.h, sig_log.h, sig_time.h; creates and waits on a sig_poller
//   host/sig_host.c:25-102               boot_and_shutdown follows sig_host_run: store, runtime, loop (single-threaded), modules, arm, start, wait or loop run, stop, disarm, destroy runtime, loop, store
//   docs/architecture.md                 rule 2 (never call runtime control from service threads), rule 5, "Single-threaded operation".
//                                        The document calls one thing an "edit lock" and a "control mutex"; the code has a single mutex (ctl_mtx),
//                                        which the header calls the "service-control lock", and sig_runtime_edit runs under it.
model {
  extend sig {
    runtime = module 'Runtime' {
      technology 'sig_runtime.h, sig_loop.h, sig_tap.h; part of sig::sig'
      description '
        Owns one running system: the project loaded from the store, the runtime
        modules registered with it, and the lifecycle that starts and stops them.
        The runtime borrows the persistence store and the capsule registry it was
        created with; both must outlive it. It can also be given an event loop,
        which makes every service driven and the whole system single-threaded.
      '

      lifecycle = component 'Lifecycle state machine' {
        technology 'sig_runtime_create/start/stop; sig_runtime.c'
        description '
          States are CREATED, STARTING, RUNNING, STOPPING, back to CREATED, and a
          stopped runtime may be started again. sig_runtime_start loads the
          project from the store, creates every module, starts every module,
          puts each service in the execution mode of the runtime, then starts the
          services flagged auto_start; a failure of an auto-start service is
          logged but does not fail the call. If loading or any module step fails,
          the modules are torn down in reverse, the project is destroyed and the
          state returns to CREATED. sig_runtime_stop is a no-op in CREATED,
          SIG_ERR_STATE while STARTING or STOPPING, and otherwise stops all
          services, clears the tap, stops then destroys every module in reverse,
          and destroys the project.
        '
      }

      shutdown = component 'Shutdown request' {
        technology 'sig_runtime_request_shutdown/wait; sig_runtime.c'
        description '
          sig_runtime_request_shutdown records the request under a mutex and
          signals a condition variable, from any thread; it only records, and it
          is NOT async-signal-safe, so a host blocks the signals and calls it
          from a dedicated sigwait() thread. sig_runtime_wait blocks until the
          request has been made since the last start; sig_runtime_shutdown_requested
          is the non-blocking form. sig_runtime_start clears an earlier request.
          With a loop set, a request also wakes the loop.
        '
      }

      modules = component 'Runtime module registry' {
        technology 'sig_runtime_module; sig_runtime.c'
        description '
          A runtime module is a name plus optional create, start, stop and destroy
          hooks, run on the thread that calls sig_runtime_start or sig_runtime_stop.
          Registration is valid only in CREATED, a duplicate name is SIG_ERR_EXISTS,
          and the config string is copied. Startup is two-phase: create runs for
          every module in registration order before any start runs, so a create
          may use the state of modules registered before it
          (sig_runtime_module_state). Shutdown stops every module and then
          destroys every module, each in reverse registration order.
        '
      }

      control = component 'Control mutex (edit lock)' {
        technology 'sig_runtime_edit, sig_runtime_service_*; one sig_mutex'
        description '
          One control mutex (the service-control lock in the header) guards the
          state and serializes sig_runtime_service_start, stop, restart and
          start_prebuilt, sig_runtime_edit, sig_runtime_find_terminal and
          sig_runtime_dump_info. The service calls, edit and find_terminal return SIG_ERR_STATE
          unless the runtime is RUNNING (start_prebuilt returns SIG_ERR_STALE for
          a stopped service whose definition changed); uptime returns 0.0 and
          dump_info reports a partial snapshot when not RUNNING. sig_runtime_edit runs a caller function on the
          project under that lock and is the only safe way to call the
          sig_project editing functions while running. The mutex is held across
          service start and stop, which join worker threads. Rule: never call
          sig_runtime_service_*, sig_runtime_uptime_seconds or
          sig_runtime_dump_info from a service or capsule thread, because the
          thread being joined may be the caller and the call deadlocks. Call
          them from module, transport or host threads only.
        '
      }

      tap = component 'Signal tap installation' {
        technology 'sig_runtime_set_tap; sig_tap.h'
        description '
          sig_runtime_set_tap installs one observer on every service of the
          running project, and on services configured later (a rebuild after an
          edit keeps it); a NULL function clears it. A tap sees each signal at
          the terminal boundary: SIG_TAP_OUTPUT when a capsule notifies an output
          terminal, routed or not, and SIG_TAP_INPUT just before an input handler
          runs. The callback runs on the emitting thread, a service worker or the
          loop thread, and must not block. With no tap the signal path pays one
          atomic pointer load. The runtime forgets the tap when it stops. The
          signal feed is the only user, and it installs the tap only while a
          subscription exists. The terminal lookup a subscriber uses to validate
          names, sig_runtime_find_terminal, belongs to the control component above
          (it takes the control mutex).
        '
      }

      loop = component 'Event loop' {
        technology 'sig_loop.h; over sig_poller'
        description '
          Single-threaded dispatch: fd watches, one-shot timers and a step hook,
          over a sig_poller so the same code runs on poll, kqueue or epoll. Each
          iteration runs the step hook, fires due timers, then sleeps until the
          earlier of the step deadline and the next timer or fd event (capped at
          one hour). Everything except sig_loop_wake and sig_loop_stop must be
          called on the thread that runs sig_loop_run, or before it starts.
          Callbacks may add, change and remove watches and timers, including
          their own; a watch must be removed before its fd is closed.
        '
      }

      stepping = component 'Driven mode and stepping' {
        technology 'sig_runtime_set_loop, sig_runtime_step'
        description '
          sig_runtime_set_loop gives the runtime a loop (CREATED only, else
          SIG_ERR_STATE). From then on every service is driven: it gets no worker
          thread and a wake callback that wakes the loop. The host loop calls
          sig_runtime_step, which steps every running driven service once while
          holding the control mutex and reports the earliest next deadline.
          Handlers, jobs and management requests then all run on the loop thread,
          so the rule that an instance belongs to one thread still holds. Runtime
          modules find the loop with sig_runtime_loop and must remove their own
          fds and timers in stop.
        '
      }
    }
  }

  sig.runtime.lifecycle -[calls]-> sig.runtime.modules 'create all, start all, then stop and destroy in reverse'
  sig.runtime.lifecycle -[calls]-> sig.runtime.shutdown 'start clears a pending request'
  sig.runtime.lifecycle -[calls]-> sig.runtime.tap 'stop clears the tap on every service before modules go'
  sig.runtime.lifecycle -[calls]-> sig.project.loader 'sig_project_load at start'
  sig.runtime.lifecycle -[calls]-> sig.project.ownership 'auto-start at start, stop_all and destroy at stop'
  sig.runtime.lifecycle -[calls]-> sig.service.driven 'in driven mode only: sets driven and the wake callback on each service'
  sig.runtime.lifecycle -[calls]-> sig.platform.threads 'control mutex, shutdown mutex and condition'
  sig.runtime.lifecycle -[calls]-> sig.platform.time 'records the start time'
  sig.runtime.lifecycle -[calls]-> sig.foundation.logging 'logs state changes and module failures'
  sig.runtime.lifecycle -[calls]-> sig.foundation.allocation 'allocates the runtime and its module table'
  sig.runtime.shutdown -[signals]-> sig.runtime.loop 'a request wakes the loop when one is set'
  sig.runtime.control -[calls]-> sig.project.introspection 'looks services up by name under the control mutex'
  sig.runtime.control -[calls]-> sig.project.dirty 'start and restart rebuild a stale stopped service'
  sig.runtime.control -[calls]-> sig.service.lifecycle 'start and stop under the control mutex; blocks until hooks have run'
  sig.runtime.tap -[calls]-> sig.service.tap 'installs the tap on each service'
  sig.runtime.tap -[calls]-> sig.project.introspection 'walks the services'
  sig.runtime.stepping -[calls]-> sig.service.driven 'steps each running driven service'
  sig.runtime.stepping -[calls]-> sig.project.introspection 'walks the services'
  sig.runtime.stepping -[signals]-> sig.runtime.loop 'service wake callback calls sig_loop_wake'
  sig.runtime.loop -[calls]-> sig.platform.poller 'sleeps in sig_poller_wait; wakes with sig_poller_wake'
  sig.runtime.loop -[calls]-> sig.platform.time 'timer deadlines'
  sig.runtime.loop -[calls]-> sig.foundation.logging 'logs a failed poller wait'
  sig.runtime.loop -[calls]-> sig.foundation.allocation 'allocates watches and timers'
}

views {
  view runtime {
    title 'Runtime'
    include sig.runtime, sig.runtime.*
  }

  view runtime_components of sig.runtime {
    title 'Runtime components'
    include *
  }

  dynamic view boot_and_shutdown {
    title 'Boot and shutdown (sig_host_run)'
    description 'The sequence of sig_host_run in host/sig_host.c, as it meets the persistence store, the runtime, the project and the service. Single-threaded mode (-s) adds the loop steps and replaces the sigwait thread by a self-pipe watched by the loop.'

    sig.host.runner -> sig.persistence.store 'sig_persistence_create opens the store (the file backend, from the project directory)'
    sig.host.runner -> sig.runtime.lifecycle 'sig_runtime_create takes the store and the capsule registry (both borrowed)'
    sig.host.runner -> sig.runtime.loop 'Single-threaded mode only: sig_loop_create and sig_loop_set_step(host_step)'
    sig.host.runner -> sig.runtime.stepping 'Single-threaded mode only: sig_runtime_set_loop (CREATED only)'
    sig.host.runner -> sig.runtime.modules 'sig_runtime_register_module for each configured module, in order (CREATED only)'
    sig.host.runner -> sig.host.shutdown 'arm_shutdown, before the start: a sigwait thread, or in single-threaded mode handlers and a self-pipe on the loop'
    sig.host.runner -> sig.runtime.lifecycle 'sig_runtime_start'
    sig.runtime.lifecycle -> sig.project.loader 'state STARTING, clears any shutdown request, then sig_project_load reads the store'
    sig.project.loader -> sig.project.parser 'configurations are parsed first, then services, whose instances are wired in two passes'
    sig.runtime.lifecycle -> sig.runtime.modules 'create hook of every module in registration order, then start hook of every module'
    sig.runtime.lifecycle -> sig.project.ownership 'each service is put in driven or threaded mode, then sig_project_start_auto'
    sig.project.ownership -> sig.service.lifecycle 'every auto_start service: start hooks run on the calling thread, then the worker thread is spawned (none if driven); state becomes RUNNING'
    sig.host.runner -> sig.runtime.shutdown 'Threaded mode: sig_runtime_wait blocks until a shutdown is requested'
    sig.host.runner -> sig.runtime.loop 'Single-threaded mode instead: sig_loop_run until the step hook sees a shutdown request and calls sig_loop_stop'
    sig.host.shutdown -> sig.runtime.shutdown 'On SIGINT or SIGTERM: sig_runtime_request_shutdown sets the flag, notifies the condition, wakes the loop if set'
    sig.host.runner -> sig.runtime.lifecycle 'sig_runtime_stop'
    sig.runtime.lifecycle -> sig.project.ownership 'state STOPPING, then sig_project_stop_all'
    sig.project.ownership -> sig.service.lifecycle 'sig_service_stop: worker joined first, then stop hooks run on the calling thread'
    sig.runtime.lifecycle -> sig.runtime.tap 'the tap is cleared on every service; the control mutex is released'
    sig.runtime.lifecycle -> sig.runtime.modules 'stop hook of every module in reverse order, then destroy hook of every module in reverse order'
    sig.runtime.lifecycle -> sig.project.ownership 'sig_project_destroy: each service stopped, its instances destroyed, the service destroyed; then configurations; state CREATED'
    sig.host.runner -> sig.host.shutdown 'disarm_shutdown: the thread is joined and the signal mask restored, or the handlers restored and the pipe closed'
    sig.host.runner -> sig.runtime.lifecycle 'sig_runtime_destroy'
    sig.host.runner -> sig.runtime.loop 'Single-threaded mode only: sig_loop_destroy'
    sig.host.runner -> sig.persistence.store 'sig_persistence_destroy, last because the runtime borrows the store'
  }
}
